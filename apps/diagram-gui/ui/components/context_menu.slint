import { Theme } from "../theme.slint";

export component ContextMenuItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <string> shortcut: "";
    callback clicked();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-elevated : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.icon != "": Text {
                text: root.icon;
                font-size: 12px;
                color: Theme.accent-cyan;
                vertical-alignment: center;
            }
            Text {
                text: root.text;
                font-size: 12px;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        if root.shortcut != "": Text {
            text: root.shortcut;
            font-size: 10px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

export component ContextMenu inherits Rectangle {
    in property <bool> is_open: false;
    in property <length> menu_x: 0px;
    in property <length> menu_y: 0px;

    visible: is_open;
    x: menu_x;
    y: menu_y;
    width: 200px;
    background: Theme.bg-card;
    border-color: Theme.border-medium;
    border-width: 1px;
    border-radius: Theme.radius-md;
    drop-shadow-blur: 20px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 6px;
    z: 100;
}
